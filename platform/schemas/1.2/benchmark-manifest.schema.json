{
  "$defs": {
    "BenchmarkSegmentationPolicy": {
      "additionalProperties": false,
      "description": "The data-set-level policy; it must never vary by Adapter.",
      "properties": {
        "schema_version": {
          "const": "benchmark-segmentation/1",
          "default": "benchmark-segmentation/1",
          "title": "Schema Version",
          "type": "string"
        },
        "max_enveloped_characters": {
          "const": 600,
          "default": 600,
          "title": "Max Enveloped Characters",
          "type": "integer"
        },
        "unicode_normalization": {
          "const": "unicode-nfc-v1",
          "default": "unicode-nfc-v1",
          "title": "Unicode Normalization",
          "type": "string"
        },
        "renderer": {
          "const": "rag-benchmark-segment-envelope/1",
          "default": "rag-benchmark-segment-envelope/1",
          "title": "Renderer",
          "type": "string"
        },
        "split_strategy": {
          "const": "structural-then-boundary/1",
          "default": "structural-then-boundary/1",
          "title": "Split Strategy",
          "type": "string"
        }
      },
      "title": "BenchmarkSegmentationPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rag-benchmark-contract/1",
      "default": "rag-benchmark-contract/1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "source_release_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Release Id"
    },
    "source_release_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Release Digest"
    },
    "corpus_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Digest",
      "type": "string"
    },
    "segmentation_policy": {
      "$ref": "#/$defs/BenchmarkSegmentationPolicy"
    },
    "file_checksums": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "File Checksums",
      "type": "object"
    },
    "segment_count": {
      "minimum": 1,
      "title": "Segment Count",
      "type": "integer"
    },
    "case_count": {
      "minimum": 1,
      "title": "Case Count",
      "type": "integer"
    },
    "contract_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Digest",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "name",
    "version",
    "corpus_digest",
    "segment_count",
    "case_count",
    "contract_digest"
  ],
  "title": "BenchmarkManifest",
  "type": "object"
}
