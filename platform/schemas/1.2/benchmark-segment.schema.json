{
  "$defs": {
    "BenchmarkPresentationLocation": {
      "additionalProperties": false,
      "description": "A source location retained solely for presentation and human audit.",
      "properties": {
        "coordinate_system": {
          "minLength": 1,
          "title": "Coordinate System",
          "type": "string"
        },
        "coordinates": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Coordinates",
          "type": "object"
        }
      },
      "required": [
        "coordinate_system"
      ],
      "title": "BenchmarkPresentationLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One strict-comparison retrieval leaf.\n\n``parent_segment_id`` identifies the logical pre-split source segment. It\nmay be absent from ``segments.jsonl`` because parent nodes are lineage\nrecords, not retrievable corpus leaves.",
  "properties": {
    "segment_id": {
      "minLength": 1,
      "title": "Segment Id",
      "type": "string"
    },
    "parent_segment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Segment Id"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "root_object_id": {
      "minLength": 1,
      "title": "Root Object Id",
      "type": "string"
    },
    "structure_type": {
      "minLength": 1,
      "title": "Structure Type",
      "type": "string"
    },
    "source_object_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Object Ids",
      "type": "array"
    },
    "ordinal": {
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "content": {
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "lineage": {
      "additionalProperties": true,
      "title": "Lineage",
      "type": "object"
    },
    "presentation_locations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BenchmarkPresentationLocation"
      },
      "title": "Presentation Locations",
      "type": "array"
    }
  },
  "required": [
    "segment_id",
    "document_id",
    "root_object_id",
    "structure_type",
    "source_object_ids",
    "ordinal",
    "content",
    "content_sha256"
  ],
  "title": "BenchmarkSegment",
  "type": "object"
}
