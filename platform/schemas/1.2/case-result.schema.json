{
  "$defs": {
    "CaseError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CaseError",
      "type": "object"
    },
    "FailureAssessment": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "items": {
            "$ref": "#/$defs/FailureLabel"
          },
          "title": "Labels",
          "type": "array"
        },
        "certainty": {
          "default": "unknown",
          "enum": [
            "deterministic",
            "reviewed",
            "unknown"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        }
      },
      "title": "FailureAssessment",
      "type": "object"
    },
    "FailureLabel": {
      "enum": [
        "provenance_unavailable",
        "retrieval_missing",
        "ranking_failure",
        "context_selection_loss",
        "generation_failure",
        "unsupported_answer",
        "timeout",
        "adapter_error",
        "dataset_issue",
        "partial_coverage",
        "unsupported_stage",
        "runtime_error",
        "mapping_corrupted",
        "needs_review"
      ],
      "title": "FailureLabel",
      "type": "string"
    },
    "GoldAnswer": {
      "additionalProperties": false,
      "properties": {
        "gold_answer_id": {
          "minLength": 1,
          "title": "Gold Answer Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GoldAnswerKind"
        },
        "canonical": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical"
        },
        "accepted_values": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Values",
          "type": "array"
        },
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "gold_answer_id",
        "kind"
      ],
      "title": "GoldAnswer",
      "type": "object"
    },
    "GoldAnswerKind": {
      "enum": [
        "text",
        "numeric",
        "formula",
        "set",
        "abstain"
      ],
      "title": "GoldAnswerKind",
      "type": "string"
    },
    "GoldEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "object": "#/$defs/ObjectLocator",
              "page_region": "#/$defs/PageRegionLocator",
              "table_cell": "#/$defs/TableCellLocator",
              "text_span": "#/$defs/TextSpanLocator"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextSpanLocator"
            },
            {
              "$ref": "#/$defs/ObjectLocator"
            },
            {
              "$ref": "#/$defs/TableCellLocator"
            },
            {
              "$ref": "#/$defs/PageRegionLocator"
            }
          ],
          "title": "Locator"
        },
        "canonical_object_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Object Id"
        },
        "canonical_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Value"
        },
        "quote_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Anchor"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "locator"
      ],
      "title": "GoldEvidence",
      "type": "object"
    },
    "GoldEvidenceSet": {
      "additionalProperties": false,
      "properties": {
        "gold_evidence_set_id": {
          "minLength": 1,
          "title": "Gold Evidence Set Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "required_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Required Groups",
          "type": "array"
        },
        "source_identities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoldSourceIdentity"
          },
          "title": "Source Identities",
          "type": "array"
        },
        "mses_paths": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mses Paths"
        }
      },
      "required": [
        "gold_evidence_set_id",
        "evidence",
        "required_groups"
      ],
      "title": "GoldEvidenceSet",
      "type": "object"
    },
    "GoldSourceIdentity": {
      "additionalProperties": false,
      "description": "Canonical Benchmark source pin required by Unified Evaluation v2.",
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_coordinate_schema": {
          "minLength": 1,
          "title": "Source Coordinate Schema",
          "type": "string"
        },
        "canonical_catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Catalog Sha256",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source_sha256",
        "source_coordinate_schema",
        "canonical_catalog_sha256"
      ],
      "title": "GoldSourceIdentity",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "scorer_id": {
          "minLength": 1,
          "title": "Scorer Id",
          "type": "string"
        },
        "scorer_version": {
          "minLength": 1,
          "title": "Scorer Version",
          "type": "string"
        },
        "scorer_digest": {
          "minLength": 1,
          "title": "Scorer Digest",
          "type": "string"
        },
        "evaluator_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluator Mode"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "metric_id",
        "status",
        "scorer_id",
        "scorer_version",
        "scorer_digest"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "observed",
        "unavailable",
        "not_applicable",
        "error",
        "needs_review"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "ObjectLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "object_type": {
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id"
      ],
      "title": "ObjectLocator",
      "type": "object"
    },
    "PageRegionLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "page_region",
          "default": "page_region",
          "title": "Type",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "PageRegionLocator",
      "type": "object"
    },
    "RAGEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "locator": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "object": "#/$defs/ObjectLocator",
                  "page_region": "#/$defs/PageRegionLocator",
                  "table_cell": "#/$defs/TableCellLocator",
                  "text_span": "#/$defs/TextSpanLocator"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextSpanLocator"
                },
                {
                  "$ref": "#/$defs/ObjectLocator"
                },
                {
                  "$ref": "#/$defs/TableCellLocator"
                },
                {
                  "$ref": "#/$defs/PageRegionLocator"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "token_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Count"
        },
        "native_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "item_id",
        "rank",
        "content"
      ],
      "title": "RAGEvidenceItem",
      "type": "object"
    },
    "RAGResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "raw_retrieval": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RAGEvidenceItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Retrieval"
        },
        "ranked_retrieval": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RAGEvidenceItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranked Retrieval"
        },
        "final_context": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RAGEvidenceItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Context"
        },
        "latency": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency"
        },
        "token_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        },
        "trace": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace"
        },
        "native_metadata": {
          "additionalProperties": true,
          "title": "Native Metadata",
          "type": "object"
        },
        "segment_traces": {
          "anyOf": [
            {
              "$ref": "#/$defs/SegmentTraceSet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "RAGResult",
      "type": "object"
    },
    "SegmentClauseMatrix": {
      "additionalProperties": false,
      "properties": {
        "path_index": {
          "minimum": 0,
          "title": "Path Index",
          "type": "integer"
        },
        "clause_index": {
          "minimum": 0,
          "title": "Clause Index",
          "type": "integer"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        },
        "matched_segment_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Matched Segment Ids",
          "type": "array"
        },
        "earliest_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earliest Rank"
        }
      },
      "required": [
        "path_index",
        "clause_index",
        "alternatives"
      ],
      "title": "SegmentClauseMatrix",
      "type": "object"
    },
    "SegmentEvaluationOutcome": {
      "enum": [
        "complete",
        "retrieval_missing",
        "partial_coverage",
        "unsupported_stage",
        "runtime_error",
        "mapping_corrupted",
        "not_applicable"
      ],
      "title": "SegmentEvaluationOutcome",
      "type": "string"
    },
    "SegmentEvaluationStage": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "raw",
            "ranked",
            "context"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SegmentTraceStatus"
        },
        "outcome": {
          "$ref": "#/$defs/SegmentEvaluationOutcome"
        },
        "strict_rankable": {
          "title": "Strict Rankable",
          "type": "boolean"
        },
        "clause_matrix": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SegmentClauseMatrix"
          },
          "title": "Clause Matrix",
          "type": "array"
        },
        "complete_path_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Complete Path Indices",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "stage",
        "status",
        "outcome",
        "strict_rankable"
      ],
      "title": "SegmentEvaluationStage",
      "type": "object"
    },
    "SegmentEvaluationTrace": {
      "additionalProperties": false,
      "properties": {
        "benchmark_contract_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Benchmark Contract Digest",
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/SegmentEvaluationStage"
        },
        "ranked": {
          "$ref": "#/$defs/SegmentEvaluationStage"
        },
        "context": {
          "$ref": "#/$defs/SegmentEvaluationStage"
        }
      },
      "required": [
        "benchmark_contract_digest",
        "raw",
        "ranked",
        "context"
      ],
      "title": "SegmentEvaluationTrace",
      "type": "object"
    },
    "SegmentTraceItem": {
      "additionalProperties": false,
      "description": "A native retrieval item with an adapter-auditable segment relation.",
      "properties": {
        "native_chunk_id": {
          "minLength": 1,
          "title": "Native Chunk Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Segment Ids",
          "type": "array"
        },
        "mapping_receipt_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mapping Receipt Digest",
          "type": "string"
        }
      },
      "required": [
        "native_chunk_id",
        "rank",
        "source_segment_ids",
        "mapping_receipt_digest"
      ],
      "title": "SegmentTraceItem",
      "type": "object"
    },
    "SegmentTraceSet": {
      "additionalProperties": false,
      "description": "The full stage set returned for one query under the vNext contract.",
      "properties": {
        "raw": {
          "$ref": "#/$defs/SegmentTraceStage"
        },
        "ranked": {
          "$ref": "#/$defs/SegmentTraceStage"
        },
        "context": {
          "$ref": "#/$defs/SegmentTraceStage"
        }
      },
      "required": [
        "raw",
        "ranked",
        "context"
      ],
      "title": "SegmentTraceSet",
      "type": "object"
    },
    "SegmentTraceStage": {
      "additionalProperties": false,
      "description": "One of raw, ranked, or final-context retrieval observations.",
      "properties": {
        "stage": {
          "enum": [
            "raw",
            "ranked",
            "context"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SegmentTraceStatus"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SegmentTraceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "mapping_manifest_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Manifest Digest"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "SegmentTraceStage",
      "type": "object"
    },
    "SegmentTraceStatus": {
      "description": "Observation state for one retrieval boundary in a benchmark query.",
      "enum": [
        "observed",
        "unsupported_stage",
        "runtime_error",
        "mapping_corrupted"
      ],
      "title": "SegmentTraceStatus",
      "type": "string"
    },
    "TableCellLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table_cell",
          "default": "table_cell",
          "title": "Type",
          "type": "string"
        },
        "table_id": {
          "minLength": 1,
          "title": "Table Id",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Row"
