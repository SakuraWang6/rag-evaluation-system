{
  "$defs": {
    "GoldEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "object": "#/$defs/ObjectLocator",
              "page_region": "#/$defs/PageRegionLocator",
              "table_cell": "#/$defs/TableCellLocator",
              "text_span": "#/$defs/TextSpanLocator"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextSpanLocator"
            },
            {
              "$ref": "#/$defs/ObjectLocator"
            },
            {
              "$ref": "#/$defs/TableCellLocator"
            },
            {
              "$ref": "#/$defs/PageRegionLocator"
            }
          ],
          "title": "Locator"
        },
        "canonical_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Value"
        },
        "quote_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Anchor"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "locator"
      ],
      "title": "GoldEvidence",
      "type": "object"
    },
    "ObjectLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "object_type": {
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id"
      ],
      "title": "ObjectLocator",
      "type": "object"
    },
    "PageRegionLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "page_region",
          "default": "page_region",
          "title": "Type",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "PageRegionLocator",
      "type": "object"
    },
    "TableCellLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table_cell",
          "default": "table_cell",
          "title": "Type",
          "type": "string"
        },
        "table_id": {
          "minLength": 1,
          "title": "Table Id",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Column"
        }
      },
      "required": [
        "table_id",
        "row",
        "column"
      ],
      "title": "TableCellLocator",
      "type": "object"
    },
    "TextSpanLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text_span",
          "default": "text_span",
          "title": "Type",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpanLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gold_evidence_set_id": {
      "minLength": 1,
      "title": "Gold Evidence Set Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/GoldEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "required_groups": {
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Required Groups",
      "type": "array"
    },
    "mses_paths": {
      "anyOf": [
        {
          "items": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mses Paths"
    }
  },
  "required": [
    "gold_evidence_set_id",
    "evidence",
    "required_groups"
  ],
  "title": "GoldEvidenceSet",
  "type": "object"
}
