{
  "$defs": {
    "ObjectLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "object_type": {
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id"
      ],
      "title": "ObjectLocator",
      "type": "object"
    },
    "PageRegionLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "page_region",
          "default": "page_region",
          "title": "Type",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "PageRegionLocator",
      "type": "object"
    },
    "RAGEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "locator": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "object": "#/$defs/ObjectLocator",
                  "page_region": "#/$defs/PageRegionLocator",
                  "table_cell": "#/$defs/TableCellLocator",
                  "text_span": "#/$defs/TextSpanLocator"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextSpanLocator"
                },
                {
                  "$ref": "#/$defs/ObjectLocator"
                },
                {
                  "$ref": "#/$defs/TableCellLocator"
                },
                {
                  "$ref": "#/$defs/PageRegionLocator"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "token_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Count"
        },
        "native_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "item_id",
        "rank",
        "content"
      ],
      "title": "RAGEvidenceItem",
      "type": "object"
    },
    "SegmentTraceItem": {
      "additionalProperties": false,
      "description": "A native retrieval item with an adapter-auditable segment relation.",
      "properties": {
        "native_chunk_id": {
          "minLength": 1,
          "title": "Native Chunk Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Segment Ids",
          "type": "array"
        },
        "mapping_receipt_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mapping Receipt Digest",
          "type": "string"
        }
      },
      "required": [
        "native_chunk_id",
        "rank",
        "source_segment_ids",
        "mapping_receipt_digest"
      ],
      "title": "SegmentTraceItem",
      "type": "object"
    },
    "SegmentTraceSet": {
      "additionalProperties": false,
      "description": "The full stage set returned for one query under the vNext contract.",
      "properties": {
        "raw": {
          "$ref": "#/$defs/SegmentTraceStage"
        },
        "ranked": {
          "$ref": "#/$defs/SegmentTraceStage"
        },
        "context": {
          "$ref": "#/$defs/SegmentTraceStage"
        }
      },
      "required": [
        "raw",
        "ranked",
        "context"
      ],
      "title": "SegmentTraceSet",
      "type": "object"
    },
    "SegmentTraceStage": {
      "additionalProperties": false,
      "description": "One of raw, ranked, or final-context retrieval observations.",
      "properties": {
        "stage": {
          "enum": [
            "raw",
            "ranked",
            "context"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SegmentTraceStatus"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SegmentTraceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "mapping_manifest_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Manifest Digest"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "SegmentTraceStage",
      "type": "object"
    },
    "SegmentTraceStatus": {
      "description": "Observation state for one retrieval boundary in a benchmark query.",
      "enum": [
        "observed",
        "unsupported_stage",
        "runtime_error",
        "mapping_corrupted"
      ],
      "title": "SegmentTraceStatus",
      "type": "string"
    },
    "TableCellLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table_cell",
          "default": "table_cell",
          "title": "Type",
          "type": "string"
        },
        "table_id": {
          "minLength": 1,
          "title": "Table Id",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Column"
        }
      },
      "required": [
        "table_id",
        "row",
        "column"
      ],
      "title": "TableCellLocator",
      "type": "object"
    },
    "TextSpanLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text_span",
          "default": "text_span",
          "title": "Type",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpanLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "raw_retrieval": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RAGEvidenceItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Retrieval"
    },
    "ranked_retrieval": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RAGEvidenceItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ranked Retrieval"
    },
    "final_context": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RAGEvidenceItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Context"
    },
    "latency": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency"
    },
    "token_usage": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Usage"
    },
    "trace": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace"
    },
    "native_metadata": {
      "additionalProperties": true,
      "title": "Native Metadata",
      "type": "object"
    },
    "segment_traces": {
      "anyOf": [
        {
          "$ref": "#/$defs/SegmentTraceSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "RAGResult",
  "type": "object"
}
