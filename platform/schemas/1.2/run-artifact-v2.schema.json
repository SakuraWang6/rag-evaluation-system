{
  "$defs": {
    "AdapterCapabilitiesV2": {
      "additionalProperties": false,
      "description": "Adapter observation capabilities, independent of runtime behavior.",
      "properties": {
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ingestion_catalog": {
          "default": false,
          "title": "Ingestion Catalog",
          "type": "boolean"
        },
        "candidate_retrieval": {
          "default": false,
          "title": "Candidate Retrieval",
          "type": "boolean"
        },
        "ranked_retrieval": {
          "default": false,
          "title": "Ranked Retrieval",
          "type": "boolean"
        },
        "final_context": {
          "default": false,
          "title": "Final Context",
          "type": "boolean"
        },
        "prompt_trace": {
          "default": false,
          "title": "Prompt Trace",
          "type": "boolean"
        },
        "answer": {
          "default": false,
          "title": "Answer",
          "type": "boolean"
        },
        "provenance": {
          "default": false,
          "title": "Provenance",
          "type": "boolean"
        },
        "transformation_lineage": {
          "default": false,
          "title": "Transformation Lineage",
          "type": "boolean"
        },
        "latency_breakdown": {
          "default": false,
          "title": "Latency Breakdown",
          "type": "boolean"
        },
        "token_usage": {
          "default": false,
          "title": "Token Usage",
          "type": "boolean"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/StageTransitionDeclaration"
          },
          "title": "Transitions",
          "type": "array"
        }
      },
      "title": "AdapterCapabilitiesV2",
      "type": "object"
    },
    "ArtifactCaseReferenceV2": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "repetition": {
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "repetition",
        "path",
        "sha256"
      ],
      "title": "ArtifactCaseReferenceV2",
      "type": "object"
    },
    "ArtifactChecksumGraphV2": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/ArtifactMemberV2"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "graph_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Graph Digest",
          "type": "string"
        }
      },
      "required": [
        "nodes",
        "graph_digest"
      ],
      "title": "ArtifactChecksumGraphV2",
      "type": "object"
    },
    "ArtifactMemberV2": {
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "minLength": 1,
          "title": "Member Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "member_id",
        "path",
        "sha256"
      ],
      "title": "ArtifactMemberV2",
      "type": "object"
    },
    "BenchmarkIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "dataset_release_id": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Dataset Release Id",
          "type": "string"
        },
        "dataset_release_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Release Digest",
          "type": "string"
        },
        "bundle_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "case_selection_id": {
          "minLength": 1,
          "title": "Case Selection Id",
          "type": "string"
        },
        "benchmark_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Benchmark Snapshot Digest",
          "type": "string"
        },
        "source_identities": {
          "items": {
            "$ref": "#/$defs/GoldSourceIdentity"
          },
          "minItems": 1,
          "title": "Source Identities",
          "type": "array"
        }
      },
      "required": [
        "dataset_release_id",
        "dataset_release_digest",
        "bundle_id",
        "case_selection_id",
        "benchmark_snapshot_digest",
        "source_identities"
      ],
      "title": "BenchmarkIdentityV2",
      "type": "object"
    },
    "GoldSourceIdentity": {
      "additionalProperties": false,
      "description": "Canonical Benchmark source pin required by Unified Evaluation v2.",
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_coordinate_schema": {
          "minLength": 1,
          "title": "Source Coordinate Schema",
          "type": "string"
        },
        "canonical_catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Catalog Sha256",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source_sha256",
        "source_coordinate_schema",
        "canonical_catalog_sha256"
      ],
      "title": "GoldSourceIdentity",
      "type": "object"
    },
    "ObservationProfileIdentity": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/AdapterCapabilitiesV2"
        },
        "profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "adapter_id",
        "adapter_version",
        "capabilities",
        "profile_digest"
      ],
      "title": "ObservationProfileIdentity",
      "type": "object"
    },
    "RuntimeProfileIdentity": {
      "additionalProperties": false,
      "description": "Opaque RAG-owned runtime configuration identity.",
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "system_id": {
          "minLength": 1,
          "title": "System Id",
          "type": "string"
        },
        "system_version": {
          "minLength": 1,
          "title": "System Version",
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Digest",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "system_id",
        "system_version",
        "configuration_digest"
      ],
      "title": "RuntimeProfileIdentity",
      "type": "object"
    },
    "StageName": {
      "enum": [
        "candidate",
        "ranked",
        "context"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageTransitionDeclaration": {
      "additionalProperties": false,
      "properties": {
        "source_stage": {
          "$ref": "#/$defs/StageName"
        },
        "target_stage": {
          "$ref": "#/$defs/StageName"
        },
        "mode": {
          "$ref": "#/$defs/StageTransitionMode"
        }
      },
      "required": [
        "source_stage",
        "target_stage",
        "mode"
      ],
      "title": "StageTransitionDeclaration",
      "type": "object"
    },
    "StageTransitionMode": {
      "enum": [
        "identity_subset",
        "verified_derivation",
        "unobservable"
      ],
      "title": "StageTransitionMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_contract_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Artifact Contract Version",
      "type": "string"
    },
    "producer": {
      "const": "rag_eval_platform",
      "default": "rag_eval_platform",
      "title": "Producer",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "experiment_id": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Experiment Id",
      "type": "string"
    },
    "status": {
      "const": "completed",
      "default": "completed",
      "title": "Status",
      "type": "string"
    },
    "benchmark_identity": {
      "$ref": "#/$defs/BenchmarkIdentityV2"
    },
    "runtime_profiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuntimeProfileIdentity"
      },
      "title": "Runtime Profiles",
      "type": "array"
    },
    "observation_profiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObservationProfileIdentity"
      },
      "title": "Observation Profiles",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ArtifactCaseReferenceV2"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "case_index_path": {
      "const": "case-index.json",
      "default": "case-index.json",
      "title": "Case Index Path",
      "type": "string"
    },
    "summary_path": {
      "const": "summary.json",
      "default": "summary.json",
      "title": "Summary Path",
      "type": "string"
    },
    "checksum_graph": {
      "$ref": "#/$defs/ArtifactChecksumGraphV2"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "experiment_id",
    "benchmark_identity",
    "cases",
    "checksum_graph",
    "started_at",
    "completed_at",
    "artifact_digest"
  ],
  "title": "RunArtifactManifestV2",
  "type": "object"
}
