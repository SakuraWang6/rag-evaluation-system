{
  "$defs": {
    "AdapterCapabilities": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "default": false,
          "title": "Answer",
          "type": "boolean"
        },
        "raw_retrieval": {
          "default": false,
          "title": "Raw Retrieval",
          "type": "boolean"
        },
        "ranked_retrieval": {
          "default": false,
          "title": "Ranked Retrieval",
          "type": "boolean"
        },
        "final_context": {
          "default": false,
          "title": "Final Context",
          "type": "boolean"
        },
        "object_provenance": {
          "default": false,
          "title": "Object Provenance",
          "type": "boolean"
        },
        "prompt_trace": {
          "default": false,
          "title": "Prompt Trace",
          "type": "boolean"
        },
        "rerank_trace": {
          "default": false,
          "title": "Rerank Trace",
          "type": "boolean"
        },
        "latency_breakdown": {
          "default": false,
          "title": "Latency Breakdown",
          "type": "boolean"
        },
        "token_usage": {
          "default": false,
          "title": "Token Usage",
          "type": "boolean"
        },
        "reset": {
          "default": false,
          "title": "Reset",
          "type": "boolean"
        },
        "segment_traces": {
          "default": false,
          "title": "Segment Traces",
          "type": "boolean"
        },
        "strict_segment_ranking": {
          "default": false,
          "title": "Strict Segment Ranking",
          "type": "boolean"
        }
      },
      "title": "AdapterCapabilities",
      "type": "object"
    },
    "ModelArtifactIdentity": {
      "additionalProperties": false,
      "description": "An immutable model identity; names and tags are display-only metadata.",
      "properties": {
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "requested_ref": {
          "minLength": 1,
          "title": "Requested Ref",
          "type": "string"
        },
        "resolved_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Digest"
        },
        "revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "resolver": {
          "minLength": 1,
          "title": "Resolver",
          "type": "string"
        },
        "resolved_at": {
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "display_name",
        "requested_ref",
        "resolver",
        "resolved_at"
      ],
      "title": "ModelArtifactIdentity",
      "type": "object"
    },
    "ReproducibilityRecord": {
      "additionalProperties": false,
      "properties": {
        "platform_git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform Git Commit"
        },
        "platform_dirty": {
          "title": "Platform Dirty",
          "type": "boolean"
        },
        "dirty_patch_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty Patch Digest"
        },
        "dependency_lock_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Digest",
          "type": "string"
        },
        "environment_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Digest",
          "type": "string"
        },
        "model_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model Digests",
          "type": "object"
        },
        "prompt_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Digests",
          "type": "object"
        },
        "model_artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelArtifactIdentity"
          },
          "title": "Model Artifacts",
          "type": "object"
        },
        "source_identities": {
          "additionalProperties": {
            "$ref": "#/$defs/SourceIdentity"
          },
          "title": "Source Identities",
          "type": "object"
        },
        "hardware_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Digest"
        },
        "dependency_lock_artifact": {
          "title": "Dependency Lock Artifact",
          "type": "string"
        },
        "environment_artifact": {
          "title": "Environment Artifact",
          "type": "string"
        }
      },
      "required": [
        "platform_dirty",
        "dependency_lock_digest",
        "environment_digest",
        "dependency_lock_artifact",
        "environment_artifact"
      ],
      "title": "ReproducibilityRecord",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "preparing",
        "ingesting",
        "running",
        "cancelling",
        "cancelled",
        "completed",
        "failed",
        "interrupted"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "package_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Version"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "dirty_patch_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty Patch Digest"
        },
        "direct_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direct Url"
        }
      },
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "producer": {
      "const": "rag_eval_platform",
      "default": "rag_eval_platform",
      "title": "Producer",
      "type": "string"
    },
    "artifact_contract_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Artifact Contract Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "title": "Experiment Id",
      "type": "string"
    },
    "display_name": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "execution_view": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution View"
    },
    "diagnostic_only": {
      "default": false,
      "title": "Diagnostic Only",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "bundle_id": {
      "minLength": 1,
      "title": "Bundle Id",
      "type": "string"
    },
    "dataset_release_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Release Id"
    },
    "benchmark_contract_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benchmark Contract Version"
    },
    "benchmark_contract_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Benchmark Contract Digest"
    },
    "case_selection_id": {
      "minLength": 1,
      "title": "Case Selection Id",
      "type": "string"
    },
    "platform_version": {
      "minLength": 1,
      "title": "Platform Version",
      "type": "string"
    },
    "adapter_id": {
      "minLength": 1,
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "system_id": {
      "minLength": 1,
      "title": "System Id",
      "type": "string"
    },
    "system_version": {
      "minLength": 1,
      "title": "System Version",
      "type": "string"
    },
    "declared_config": {
      "additionalProperties": true,
      "title": "Declared Config",
      "type": "object"
    },
    "effective_config": {
      "additionalProperties": true,
      "title": "Effective Config",
      "type": "object"
    },
    "scorer_id": {
      "minLength": 1,
      "title": "Scorer Id",
      "type": "string"
    },
    "scorer_version": {
      "minLength": 1,
      "title": "Scorer Version",
      "type": "string"
    },
    "scorer_digest": {
      "minLength": 1,
      "title": "Scorer Digest",
      "type": "string"
    },
    "metric_scorers": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Metric Scorers",
      "type": "object"
    },
    "model_artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelArtifactIdentity"
      },
      "title": "Model Artifacts",
      "type": "object"
    },
    "declared_capabilities": {
      "$ref": "#/$defs/AdapterCapabilities"
    },
    "observed_capabilities": {
      "$ref": "#/$defs/AdapterCapabilities"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "repetitions": {
      "minimum": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "execution_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Execution Counts",
      "type": "object"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "artifact_checksums": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Checksums",
      "type": "object"
    },
    "index_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Fingerprint"
    },
    "index_fingerprints": {
      "items": {
        "type": "string"
      },
      "title": "Index Fingerprints",
      "type": "array"
    },
    "index_input_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Input Fingerprint"
    },
    "index_artifact_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Artifact Digest"
    },
    "index_artifact_digests": {
      "items": {
        "type": "string"
      },
      "title": "Index Artifact Digests",
      "type": "array"
    },
    "latency_protocol_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Protocol Digest"
    },
    "repetition_seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Repetition Seeds",
      "type": "array"
    },
    "reproducibility": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReproducibilityRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "replay_of_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Of Run Id"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    }
  },
  "required": [
    "run_id",
    "experiment_id",
    "status",
    "bundle_id",
    "case_selection_id",
    "platform_version",
    "adapter_id",
    "adapter_version",
    "system_id",
    "system_version",
    "declared_config",
    "effective_config",
    "scorer_id",
    "scorer_version",
    "scorer_digest",
    "declared_capabilities",
    "observed_capabilities",
    "seed",
    "repetitions",
    "started_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
