{
  "$defs": {
    "ArtifactAnswerJudgment": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ArtifactAnswerStatus"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "correct",
                "incorrect"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "status"
      ],
      "title": "ArtifactAnswerJudgment",
      "type": "object"
    },
    "ArtifactAnswerStatus": {
      "enum": [
        "observed",
        "needs_review",
        "unavailable"
      ],
      "title": "ArtifactAnswerStatus",
      "type": "string"
    },
    "ArtifactEvidenceJudgment": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ArtifactEvidenceStatus"
        },
        "value": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "partial",
                "missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "status"
      ],
      "title": "ArtifactEvidenceJudgment",
      "type": "object"
    },
    "ArtifactEvidenceStatus": {
      "enum": [
        "observed",
        "unavailable"
      ],
      "title": "ArtifactEvidenceStatus",
      "type": "string"
    },
    "ArtifactVerificationView": {
      "additionalProperties": false,
      "properties": {
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "missing": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "unexpected": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unexpected",
          "type": "array"
        },
        "mismatched": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Mismatched",
          "type": "array"
        },
        "invalid_models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Invalid Models",
          "type": "array"
        }
      },
      "required": [
        "valid"
      ],
      "title": "ArtifactVerificationView",
      "type": "object"
    },
    "ArtifactViewAvailability": {
      "enum": [
        "available",
        "corrupted"
      ],
      "title": "ArtifactViewAvailability",
      "type": "string"
    },
    "RunCaseIndexEntryView": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "repetition": {
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer_judgment": {
          "$ref": "#/$defs/ArtifactAnswerJudgment"
        },
        "evidence_judgment": {
          "$ref": "#/$defs/ArtifactEvidenceJudgment"
        },
        "core_metrics_available": {
          "default": false,
          "title": "Core Metrics Available",
          "type": "boolean"
        },
        "failure_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Kind"
        }
      },
      "required": [
        "case_id",
        "repetition",
        "seed",
        "status",
        "question",
        "answer_judgment",
        "evidence_judgment"
      ],
      "title": "RunCaseIndexEntryView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "artifact_contract_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Artifact Contract Version",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/ArtifactViewAvailability"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "verification": {
      "$ref": "#/$defs/ArtifactVerificationView"
    },
    "cases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RunCaseIndexEntryView"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "availability",
    "verification"
  ],
  "title": "RunArtifactCaseIndexView",
  "type": "object"
}
