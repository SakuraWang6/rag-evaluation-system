{
  "$defs": {
    "AdapterCapabilitiesV2": {
      "additionalProperties": false,
      "description": "Adapter observation capabilities, independent of runtime behavior.",
      "properties": {
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ingestion_catalog": {
          "default": false,
          "title": "Ingestion Catalog",
          "type": "boolean"
        },
        "candidate_retrieval": {
          "default": false,
          "title": "Candidate Retrieval",
          "type": "boolean"
        },
        "ranked_retrieval": {
          "default": false,
          "title": "Ranked Retrieval",
          "type": "boolean"
        },
        "final_context": {
          "default": false,
          "title": "Final Context",
          "type": "boolean"
        },
        "prompt_trace": {
          "default": false,
          "title": "Prompt Trace",
          "type": "boolean"
        },
        "answer": {
          "default": false,
          "title": "Answer",
          "type": "boolean"
        },
        "provenance": {
          "default": false,
          "title": "Provenance",
          "type": "boolean"
        },
        "transformation_lineage": {
          "default": false,
          "title": "Transformation Lineage",
          "type": "boolean"
        },
        "latency_breakdown": {
          "default": false,
          "title": "Latency Breakdown",
          "type": "boolean"
        },
        "token_usage": {
          "default": false,
          "title": "Token Usage",
          "type": "boolean"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/StageTransitionDeclaration"
          },
          "title": "Transitions",
          "type": "array"
        }
      },
      "title": "AdapterCapabilitiesV2",
      "type": "object"
    },
    "CanonicalExtent": {
      "additionalProperties": false,
      "properties": {
        "extent_kind": {
          "minLength": 1,
          "title": "Extent Kind",
          "type": "string"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/ExtentUnit"
          },
          "minItems": 1,
          "title": "Units",
          "type": "array"
        },
        "extent_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Extent Digest",
          "type": "string"
        }
      },
      "required": [
        "extent_kind",
        "units",
        "extent_digest"
      ],
      "title": "CanonicalExtent",
      "type": "object"
    },
    "CanonicalMappingRecord": {
      "additionalProperties": false,
      "description": "Reverse view used to prove mapping completeness for a canonical object.",
      "properties": {
        "canonical_object_id": {
          "minLength": 1,
          "title": "Canonical Object Id",
          "type": "string"
        },
        "expected_extent": {
          "$ref": "#/$defs/CanonicalExtent"
        },
        "reverse_mapping_status": {
          "$ref": "#/$defs/ReverseMappingStatus"
        },
        "native_chunk_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Native Chunk Ids",
          "type": "array"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "canonical_object_id",
        "expected_extent",
        "reverse_mapping_status",
        "receipt_sha256"
      ],
      "title": "CanonicalMappingRecord",
      "type": "object"
    },
    "ContentObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_status": {
          "$ref": "#/$defs/ObservationStatus"
        },
        "completeness": {
          "$ref": "#/$defs/ObservationCompleteness"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "diagnostics": {
          "additionalProperties": true,
          "title": "Diagnostics",
          "type": "object"
        }
      },
      "required": [
        "observation_status",
        "completeness"
      ],
      "title": "ContentObservation",
      "type": "object"
    },
    "ExtentUnit": {
      "additionalProperties": false,
      "description": "One canonical scoring atom or a verified range within that atom.",
      "properties": {
        "unit_id": {
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "coordinate_system": {
          "minLength": 1,
          "title": "Coordinate System",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "coordinates": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Coordinates",
          "type": "object"
        }
      },
      "required": [
        "unit_id",
        "coordinate_system"
      ],
      "title": "ExtentUnit",
      "type": "object"
    },
    "IngestionCatalogObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_status": {
          "$ref": "#/$defs/ObservationStatus"
        },
        "completeness": {
          "$ref": "#/$defs/ObservationCompleteness"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RuntimeChunkRecord"
          },
          "title": "Items",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "diagnostics": {
          "additionalProperties": true,
          "title": "Diagnostics",
          "type": "object"
        }
      },
      "required": [
        "observation_status",
        "completeness",
        "items"
      ],
      "title": "IngestionCatalogObservation",
      "type": "object"
    },
    "LineageIntegrityStatus": {
      "enum": [
        "verified",
        "failed",
        "unknown"
      ],
      "title": "LineageIntegrityStatus",
      "type": "string"
    },
    "MappingDiagnostic": {
      "additionalProperties": false,
      "description": "A negative or unusable mapping result; never a coverage claim.",
      "properties": {
        "native_chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Chunk Id"
        },
        "canonical_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Object Id"
        },
        "status": {
          "$ref": "#/$defs/MappingDiagnosticStatus"
        },
        "mapping_tier_attempted": {
          "anyOf": [
            {
              "$ref": "#/$defs/MappingTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "diagnostics": {
          "additionalProperties": true,
          "title": "Diagnostics",
          "type": "object"
        }
      },
      "required": [
        "status",
        "reason_code"
      ],
      "title": "MappingDiagnostic",
      "type": "object"
    },
    "MappingDiagnosticStatus": {
      "enum": [
        "missing",
        "corrupted",
        "unsupported"
      ],
      "title": "MappingDiagnosticStatus",
      "type": "string"
    },
    "MappingTier": {
      "enum": [
        "native_lineage",
        "deterministic_crosswalk",
        "text_unique_exact"
      ],
      "title": "MappingTier",
      "type": "string"
    },
    "NativeLineage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "lineage_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lineage Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_sha256",
        "payload",
        "lineage_sha256"
      ],
      "title": "NativeLineage",
      "type": "object"
    },
    "NativeSpan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "coordinate_system": {
          "minLength": 1,
          "title": "Coordinate System",
          "type": "string"
        },
        "coordinates": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minProperties": 1,
          "title": "Coordinates",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "coordinate_system",
        "coordinates"
      ],
      "title": "NativeSpan",
      "type": "object"
    },
    "ObservationCompleteness": {
      "enum": [
        "complete",
        "truncated",
        "partial",
        "unknown"
      ],
      "title": "ObservationCompleteness",
      "type": "string"
    },
    "ObservationProfileIdentity": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/AdapterCapabilitiesV2"
        },
        "profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "adapter_id",
        "adapter_version",
        "capabilities",
        "profile_digest"
      ],
      "title": "ObservationProfileIdentity",
      "type": "object"
    },
    "ObservationStatus": {
      "enum": [
        "observed",
        "unsupported",
        "unobserved",
        "failed",
        "corrupted"
      ],
      "title": "ObservationStatus",
      "type": "string"
    },
    "ObservedStageItem": {
      "additionalProperties": false,
      "properties": {
        "native_chunk_id": {
          "minLength": 1,
          "title": "Native Chunk Id",
          "type": "string"
        },
        "native_rank": {
          "minimum": 1,
          "title": "Native Rank",
          "type": "integer"
        },
        "runtime_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Score"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "provenance_edge_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provenance Edge Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "native_chunk_id",
        "native_rank",
        "content_sha256"
      ],
      "title": "ObservedStageItem",
      "type": "object"
    },
    "PhysicalCellFootprint": {
      "additionalProperties": false,
      "properties": {
        "physical_cell_id": {
          "minLength": 1,
          "title": "Physical Cell Id",
          "type": "string"
        },
        "table_id": {
          "minLength": 1,
          "title": "Table Id",
          "type": "string"
        },
        "row": {
          "minimum": 1,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 1,
          "title": "Column",
          "type": "integer"
        },
        "grid_span": {
          "default": 1,
          "minimum": 1,
          "title": "Grid Span",
          "type": "integer"
        },
        "v_merge": {
          "default": "none",
          "enum": [
            "none",
            "restart",
            "continue"
          ],
          "title": "V Merge",
          "type": "string"
        },
        "merge_origin_physical_cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merge Origin Physical Cell Id"
        }
      },
      "required": [
        "physical_cell_id",
        "table_id",
        "row",
        "column"
      ],
      "title": "PhysicalCellFootprint",
      "type": "object"
    },
    "ProvenanceCoverageStatus": {
      "enum": [
        "complete",
        "partial"
      ],
      "title": "ProvenanceCoverageStatus",
      "type": "string"
    },
    "ProvenanceEdge": {
      "additionalProperties": false,
      "description": "A receipt-backed, positive runtime-to-canonical coverage claim.",
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "native_chunk_id": {
          "minLength": 1,
          "title": "Native Chunk Id",
          "type": "string"
        },
        "canonical_object_id": {
          "minLength": 1,
          "title": "Canonical Object Id",
          "type": "string"
        },
        "canonical_locator": {
          "$ref": "#/$defs/SourceSpan"
        },
        "mapping_tier": {
          "$ref": "#/$defs/MappingTier"
        },
        "coverage_status": {
          "$ref": "#/$defs/ProvenanceCoverageStatus"
        },
        "expected_extent": {
          "$ref": "#/$defs/CanonicalExtent"
        },
        "covered_extent": {
          "$ref": "#/$defs/CanonicalExtent"
        },
        "physical_cell_footprint": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PhysicalCellFootprint"
          },
          "title": "Physical Cell Footprint",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "native_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Native Content Sha256",
          "type": "string"
        },
        "native_lineage_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Lineage Sha256"
        },
        "canonical_value_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Value Sha256",
          "type": "string"
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "native_chunk_id",
        "canonical_object_id",
        "canonical_locator",
        "mapping_tier",
        "coverage_status",
        "expected_extent",
        "covered_extent",
        "source_sha256",
        "native_content_sha256",
        "canonical_value_sha256",
        "reason_code",
        "receipt_sha256"
      ],
      "title": "ProvenanceEdge",
      "type": "object"
    },
    "ReceiptStatus": {
      "enum": [
        "verified",
        "failed"
      ],
      "title": "ReceiptStatus",
      "type": "string"
    },
    "ReverseMappingStatus": {
      "enum": [
        "complete",
        "partial",
        "missing",
        "unsupported"
      ],
      "title": "ReverseMappingStatus",
      "type": "string"
    },
    "RuntimeChunkRecord": {
      "additionalProperties": false,
