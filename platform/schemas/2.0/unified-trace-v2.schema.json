          "default": null,
          "title": "Content"
        },
        "native_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "native_lineage": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeLineage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
