      "description": "One directly observed source location in ``ooxml-structural-v1``.",
      "properties": {
        "coordinate_system": {
          "const": "ooxml-structural-v1",
          "default": "ooxml-structural-v1",
          "title": "Coordinate System",
          "type": "string"
        },
        "part": {
          "minLength": 1,
          "title": "Part",
          "type": "string"
        },
        "coordinates": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minProperties": 1,
          "title": "Coordinates",
          "type": "object"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
