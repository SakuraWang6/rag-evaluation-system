        "persisted_metadata_digest"
      ],
      "title": "RuntimeChunkRecord",
      "type": "object"
    },
    "RuntimeProfileIdentity": {
      "additionalProperties": false,
      "description": "Opaque RAG-owned runtime configuration identity.",
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "system_id": {
          "minLength": 1,
          "title": "System Id",
          "type": "string"
        },
        "system_version": {
          "minLength": 1,
          "title": "System Version",
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^[0-9a-f]{64}$",
