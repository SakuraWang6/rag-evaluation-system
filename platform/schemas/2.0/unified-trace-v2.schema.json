        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "source_coordinate_schema": {
          "minLength": 1,
          "title": "Source Coordinate Schema",
          "type": "string"
        },
        "canonical_catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Catalog Sha256",
