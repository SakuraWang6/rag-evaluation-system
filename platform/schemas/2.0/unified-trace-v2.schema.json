        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text End"
        }
      },
      "required": [
        "part",
        "coordinates"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StageItemReference": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/StageName"
        },
        "native_chunk_id": {
          "minLength": 1,
          "title": "Native Chunk Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "native_chunk_id",
        "content_sha256"
      ],
