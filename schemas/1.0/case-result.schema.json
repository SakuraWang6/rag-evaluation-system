{
  "$defs": {
    "CaseError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CaseError",
      "type": "object"
    },
    "GoldAnswer": {
      "additionalProperties": false,
      "properties": {
        "gold_answer_id": {
          "minLength": 1,
          "title": "Gold Answer Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GoldAnswerKind"
        },
        "canonical": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical"
        },
        "accepted_values": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Values",
          "type": "array"
        },
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "gold_answer_id",
        "kind"
      ],
      "title": "GoldAnswer",
      "type": "object"
    },
    "GoldAnswerKind": {
      "enum": [
        "text",
        "numeric",
        "formula",
        "set",
        "abstain"
      ],
      "title": "GoldAnswerKind",
      "type": "string"
    },
    "GoldEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "object": "#/$defs/ObjectLocator",
              "page_region": "#/$defs/PageRegionLocator",
              "table_cell": "#/$defs/TableCellLocator",
              "text_span": "#/$defs/TextSpanLocator"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextSpanLocator"
            },
            {
              "$ref": "#/$defs/ObjectLocator"
            },
            {
              "$ref": "#/$defs/TableCellLocator"
            },
            {
              "$ref": "#/$defs/PageRegionLocator"
            }
          ],
          "title": "Locator"
        },
        "canonical_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Value"
        },
        "quote_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Anchor"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "locator"
      ],
      "title": "GoldEvidence",
      "type": "object"
    },
    "GoldEvidenceSet": {
      "additionalProperties": false,
      "properties": {
        "gold_evidence_set_id": {
          "minLength": 1,
          "title": "Gold Evidence Set Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "required_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Required Groups",
          "type": "array"
        }
      },
      "required": [
        "gold_evidence_set_id",
        "evidence",
        "required_groups"
      ],
      "title": "GoldEvidenceSet",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "scorer_id": {
          "minLength": 1,
          "title": "Scorer Id",
          "type": "string"
        },
        "scorer_version": {
          "minLength": 1,
          "title": "Scorer Version",
          "type": "string"
        },
        "scorer_digest": {
          "minLength": 1,
          "title": "Scorer Digest",
          "type": "string"
        },
        "evaluator_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluator Mode"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "metric_id",
        "status",
        "scorer_id",
        "scorer_version",
        "scorer_digest"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "observed",
        "unavailable",
        "not_applicable",
        "error"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "ObjectLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "object_type": {
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id"
      ],
      "title": "ObjectLocator",
      "type": "object"
    },
    "PageRegionLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "page_region",
          "default": "page_region",
          "title": "Type",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "PageRegionLocator",
      "type": "object"
    },
    "RAGEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "locator": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "object": "#/$defs/ObjectLocator",
                  "page_region": "#/$defs/PageRegionLocator",
                  "table_cell": "#/$defs/TableCellLocator",
                  "text_span": "#/$defs/TextSpanLocator"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextSpanLocator"
                },
                {
                  "$ref": "#/$defs/ObjectLocator"
                },
                {
                  "$ref": "#/$defs/TableCellLocator"
                },
                {
                  "$ref": "#/$defs/PageRegionLocator"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "token_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Count"
        },
        "native_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "item_id",
        "rank",
        "content"
      ],
      "title": "RAGEvidenceItem",
      "type": "object"
    },
    "RAGResult": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "raw_retrieval": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RAGEvidenceItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Retrieval"
        },
        "ranked_retrieval": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RAGEvidenceItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranked Retrieval"
        },
        "final_context": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RAGEvidenceItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Context"
        },
        "latency": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency"
        },
        "token_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        },
        "trace": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace"
        },
        "native_metadata": {
          "additionalProperties": true,
          "title": "Native Metadata",
          "type": "object"
        }
      },
      "title": "RAGResult",
      "type": "object"
    },
    "TableCellLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table_cell",
          "default": "table_cell",
          "title": "Type",
          "type": "string"
        },
        "table_id": {
          "minLength": 1,
          "title": "Table Id",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Column"
        }
      },
      "required": [
        "table_id",
        "row",
        "column"
      ],
      "title": "TableCellLocator",
      "type": "object"
    },
    "TextSpanLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text_span",
          "default": "text_span",
          "title": "Type",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpanLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "timeout",
        "system_error",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "gold_answer": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoldAnswer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gold_evidence_set": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoldEvidenceSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rag_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RAGResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricResult"
      },
      "title": "Metrics",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "status",
    "question",
    "started_at",
    "completed_at"
  ],
  "title": "CaseResult",
  "type": "object"
}
